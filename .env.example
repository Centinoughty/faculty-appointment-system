# Database Configuration
POSTGRES_DB=fams
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fams

# Google OAuth Credentials
# Create a project at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/login

# Security
# Run 'openssl rand -hex 32' to generate these
ACCESS_SECRET=your_32_byte_hex_secret_here
REFRESH_SECRET=your_refresh_secret_here

# App Configuration
APP_VERSION=v1.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=your-verified-sender@example.com

# AI Services (Optional)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Optional - Defaults provided in code)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_VAPID_KEY=your_vapid_key_for_notifications